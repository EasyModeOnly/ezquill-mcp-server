{
  "name": "@ezquill/mcp-server",
  "version": "0.5.0",
  "description": "MCP server for ezQuill — read a writer's manuscript, story world and timeline from an AI agent.",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EasyModeOnly/ezquill-mcp-server.git"
  },
  "homepage": "https://ezquill.com",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mcp-server": "src/index.js",
    "ezquill-mcp-server": "src/index.js",
    "ezquill-mcp-server-http": "src/http.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"__tests__/**/*.test.js\"",
    "start": "node src/index.js",
    "start:http": "node src/http.js",
    "sync-plugin-version": "node scripts/sync-plugin-version.mjs",
    "fingerprint": "node scripts/fingerprint.mjs",
    "version": "node scripts/sync-plugin-version.mjs && node scripts/fingerprint.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
